{
  "name": "red-poly",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "build": {
    "command": "bun run build:web"
  },
  "preview_urls": true,
  "previews": {}
}
